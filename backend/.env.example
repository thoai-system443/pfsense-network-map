API_PORT=8010
DOCS_USER=changeme
DOCS_PASSWORD=changeme
# Origin của frontend. Nhận cả ba cách viết:
#   CORS_ORIGINS=http://localhost:8011
#   CORS_ORIGINS=http://localhost:8011, https://map.example.com
#   CORS_ORIGINS=["http://localhost:8011"]
# Phải là scheme://host[:port], không có đường dẫn. Sai định dạng thì container
# dừng ngay lúc khởi động kèm thông báo rõ, thay vì lỗi CORS mơ hồ trên trình duyệt.
CORS_ORIGINS=http://localhost:8011
